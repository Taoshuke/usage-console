{
  // 用量看板：只有静态文件，没有 Worker 代码。登录由 Cloudflare Access 在边缘拦截，只放行用户邮箱
  // 页面与数据都在 public/，由 scripts/build.py 生成并提交；推送后由 Workers Builds 部署
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usage",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "usage.heibox.cc", "custom_domain": true }
  ],
  // 只走正式地址，workers.dev 与预览地址不受 Access 保护
  "workers_dev": false,
  "preview_urls": false
}
